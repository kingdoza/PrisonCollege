  _steps:
  - stepId: 0
    title: "0\uB2E8\uACC4. \uC5F0\uC218 \uC2DC\uC791"
    subtitle: "\uC2E0\uC784 \uAD50\uC218 \uC5F0\uC218\uC5D0 \uC624\uC2E0 \uAC83\uC744
      \uD658\uC601\uD569\uB2C8\uB2E4."
    guide: "\uAD50\uC218\uB2D8\uC758 \uC8FC\uC694 \uC784\uBB34\uB294 \uC81C\uD55C
      \uC2DC\uAC04 \uB3D9\uC548 \uB300\uD559\uC6D0\uC0DD\uC758 \uD0C8\uCD9C\uC744
      \uD1B5\uC81C\uD558\uACE0, \uD504\uB85C\uC81D\uD2B8\uB97C \uC9C4\uD589\uD574
      \uB354 \uC6D0\uD65C\uD55C \uD1B5\uC81C\uB97C \uC704\uD55C \uC790\uAE08\uC744
      \uB9C8\uB828\uD558\uB294 \uAC83\uC785\uB2C8\uB2E4. \uBCF8\uACA9\uC801\uC778
      \uAD50\uC218 \uC5C5\uBB34\uC5D0 \uD544\uC694\uD55C \uD0C8\uCD9C\uAD6C \uBD09\uC1C4,
      \uB300\uD559\uC6D0\uC0DD \uD1B5\uC81C, \uC791\uC5C5 \uC720\uB3C4\uC640 \uC6E8\uC774\uBE0C
      \uC2DC\uC2A4\uD15C\uC744 \uC775\uD799\uB2C8\uB2E4."
    objective: "\uC5F0\uC218\uB97C \uC2DC\uC791\uD558\uC138\uC694."
    inputHint: "[Tab] \uC2DC\uC791"
    completion: 
  - stepId: 1
    title: "1. \uC774\uB3D9\uACFC \uAE30\uBCF8 \uC870\uC791"
    subtitle: "\uD45C\uC2DC\uB41C \uC704\uCE58\uB85C \uC774\uB3D9"
    guide: "\uB300\uD559\uC6D0\uC0DD\uC744 \uAD00\uB9AC\uD558\uB824\uBA74 \uC274\uC0C8\uC5C6\uC774
      \uC6C0\uC9C1\uC5EC\uC57C\uD569\uB2C8\uB2E4. \uB2EC\uB9AC\uAE30, \uC810\uD504,
      \uACF5\uACA9\uC740 \uC2A4\uD14C\uBBF8\uB108\uB97C \uC18C\uBAA8\uD569\uB2C8\uB2E4."
    objective: "\uD45C\uC2DC\uB41C \uC9C0\uC810\uAE4C\uC9C0 \uC774\uB3D9\uD558\uC138\uC694."
    inputHint: "[WASD] \uC774\uB3D9\\n[Shift] \uB2EC\uB9AC\uAE30\\n[Space] \uC810\uD504"
    completion: 
  - stepId: 2
    title: "2. \uD0C8\uCD9C\uAD6C \uBD09\uC1C4"
    subtitle: "\uBAA8\uB4E0 \uBB38\uACFC \uCC3D\uBB38\uC5D0 \uBC14\uB9AC\uCF00\uC774\uB4DC
      \uC124\uCE58"
    guide: "\uBB38\uACFC \uCC3D\uBB38\uC740 \uB300\uD559\uC6D0\uC0DD\uC758 \uD0C8\uCD9C\uAD6C\uC785\uB2C8\uB2E4.
      \uD0C8\uCD9C\uAD6C\uC5D0 \uBC14\uB9AC\uCF00\uC774\uB4DC\uB97C \uC124\uCE58\uD558\uC5EC
      \uB300\uD559\uC6D0\uC0DD\uC758 \uD0C8\uCD9C\uC744 \uC9C0\uC5F0\uC2DC\uD0AC
      \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uAC15\uC870\uB41C \uD0C8\uCD9C\uAD6C\uB97C
      \uBC14\uB77C\uBCF4\uACE0 F\uD0A4\uB97C \uAE38\uAC8C \uB20C\uB7EC \uBC14\uB9AC\uCF00\uC774\uB4DC\uB97C
      \uC124\uCE58\uD558\uC138\uC694."
    objective: "\uBAA8\uB4E0 \uCD9C\uAD6C\uC5D0 \uBC14\uB9AC\uCF00\uC774\uB4DC\uB97C
      \uC124\uCE58\uD558\uC138\uC694."
    inputHint: "[F] \uBC14\uB9AC\uCF00\uC774\uB4DC \uC124\uCE58"
    completion: 
  - stepId: 3
    title: "3-1. \uC704\uD5D8 \uD589\uB3D9 \uAD6C\uBD84\uACFC \uB300\uC751"
    subtitle: "\uC815\uC0C1 \uD589\uB3D9\uACFC \uC704\uD5D8 \uD589\uB3D9 \uC2DD\uBCC4"
    guide: "\uB300\uD559\uC6D0\uC0DD\uC758 \uD589\uB3D9\uC740 \uAC89\uBCF4\uAE30\uC5D0
      \uBE44\uC2B7\uD574\uB3C4 \uC5B4\uB5A4 \uD589\uB3D9\uC740 \uD0C8\uCD9C\uACFC
      \uC9C1\uAC04\uC811\uC801\uC73C\uB85C \uC5F0\uAD00\uB41C \uC704\uD5D8\uD568
      \uD589\uB3D9\uC785\uB2C8\uB2E4. \uC815\uC0C1 \uD589\uB3D9 \uC911\uC778 \uD559\uC0DD\uC740
      \uBC29\uD574\uD558\uC9C0 \uB9D0\uACE0, \uD0C8\uCD9C \uC2DC\uB3C4 \uBC0F \uC704\uD5D8
      \uD589\uB3D9\uC744 \uD558\uACE0\uC788\uB294 \uD559\uC0DD\uB9CC \uCC3E\uC544
      \uB300\uC751\uD558\uC138\uC694."
    objective: "\uC704\uD5D8 \uD589\uB3D9 \uD559\uC0DD\uC744 \uC4F0\uB7EC\uB728\uB9AC\uC138\uC694."
    inputHint: "[LMB] \uACF5\uACA9\\n[1~4,\uB9C8\uC6B0\uC2A4\uD720] \uC7A5\uBE44
      \uC120\uD0DD"
    completion: 
  - stepId: 11
    title: "3-2. \uC815\uC804 \uB300\uC751"
    subtitle: 
    guide: "\uD574\uD0B9\uD558\uB294 \uD559\uC0DD\uC744 \uBC29\uCE58\uD558\uBA74
      \uC774\uC640\uAC19\uC774 \uC804\uB4F1\uC774 \uBAA8\uB450 \uB098\uAC00\uC11C
      \uC5F0\uAD6C\uC2E4 \uD1B5\uC81C\uC5D0 \uC9C0\uC7A5\uC774 \uC0DD\uAE41\uB2C8\uB2E4.
      \uC774\uAC19\uC740 \uACBD\uC6B0\uC5D0\uB294 \uC804\uAE30\uBC15\uC2A4\uB97C
      \uCC3E\uC544 F\uD0A4\uB97C \uAE38\uAC8C \uB20C\uB7EC \uC804\uC6D0\uC744 \uBCF5\uAD6C\uD574\uC57C\uD569\uB2C8\uB2E4."
    objective: "\uC5F0\uAD6C\uC2E4 \uC804\uC6D0\uC744 \uBCF5\uAD6C\uD558\uC138\uC694."
    inputHint: 
    completion: 
  - stepId: 12
    title: "3-3. \uC804\uC790\uB808\uC778\uC9C0 \uD654\uC7AC \uC608\uBC29"
    subtitle: 
    guide: "\uD559\uC0DD\uC740 \uC804\uC790\uB808\uC778\uC9C0\uC5D0 \uC5EC\uB7EC
      \uC885\uB958\uC758 \uC74C\uC2DD\uC744 \uB123\uAE30\uB3C4\uD569\uB2C8\uB2E4.
      \uC885\uB958\uC5D0 \uB530\uB77C\uC11C \uC5B4\uB5A4 \uC74C\uC2DD\uC740 \uD654\uC7AC\uB97C
      \uC720\uBC1C\uD569\uB2C8\uB2E4. \uD654\uC7AC \uC720\uBC1C \uC74C\uC2DD\uC744
      \uB4E4\uACE0 \uC804\uC790\uB808\uC778\uC9C0\uB85C \uD5A5\uD558\uB294 \uD559\uC0DD\uC744
      \uC0AC\uC804\uC5D0 \uC800\uC9C0\uD560 \uC218\uB3C4 \uC788\uC9C0\uB9CC \uC804\uC790\uB808\uC778\uC9C0\uC5D0
      \uC774\uBBF8 \uB123\uC5B4\uC84C\uC5B4\uB3C4 \uD130\uC9C0\uAE30\uC804\uC5D0
      \uBE84 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uC804\uC790\uB808\uC778\uC9C0\uB97C
      \uBC14\uB77C\uBCF4\uB294 \uC2DC\uC810\uAE30\uC900\uC73C\uB85C \uC6B0\uCE213\uAC1C\uB294
      \uD654\uC7AC\uC720\uBC1C, \uC88C\uCE21 3\uAC1C\uB294 \uC815\uC0C1 \uC74C\uC2DD\uB4E4\uC774\uB2C8
      \uC219\uC9C0\uBC14\uB78D\uB2C8\uB2E4."
    objective: "\uC704\uD5D8 \uC74C\uC2DD\uC744 \uC804\uC790\uB808\uC778\uC9C0\uC5D0
      \uBE7C\uC2ED\uC2DC\uC624."
    inputHint: 
    completion: 
  - stepId: 4
    title: "4-1. \uD63C\uB780 \uAD00\uB9AC"
    subtitle: "\uD63C\uC7A1\uB3C4 \uC99D\uAC00 \uD655\uC778"
    guide: "\uD63C\uC7A1\uB3C4\uB294 \uB300\uD559\uC6D0\uC0DD\uC758 \uD589\uB3D9
      \uC18D\uB3C4\uB97C \uBE60\uB974\uAC8C\uD569\uB2C8\uB2E4. \uD0C8\uCD9C\uACFC
      \uC9C1\uC811\uC801\uC778 \uAD00\uACC4\uB294 \uC5C6\uC9C0\uB9CC \uC774 \uC218\uCE58\uAC00\uB192\uC744\uC218\uB85D
      \uB09C\uC774\uB3C4\uB3C4 \uC62C\uB77C\uAC11\uB2C8\uB2E4. \uBB34\uACE0\uD55C
      \uD559\uC0DD\uC744 \uC4F0\uB7EC\uB728\uB838\uAC70\uB098 \uB300\uD559\uC6D0\uC0DD\uC758
      \uD63C\uB780 \uC720\uBC1C \uD589\uB3D9\uC73C\uB85C \uC778\uD574 \uC99D\uAC00\uD569\uB2C8\uB2E4."
    objective: "\uC9C0\uC815\uB41C \uBB34\uACE0\uD55C \uD559\uC0DD\uC744 \uC4F0\uB7EC\uB728\uB9AC\uC138\uC694."
    inputHint: "\uC9C0\uC815 \uD559\uC0DD\uC744 \uACF5\uACA9\uD558\uC138\uC694."
    completion: 
  - stepId: 5
    title: "4-2. \uD63C\uB780 \uAC10\uC18C"
    subtitle: "\uD63C\uC7A1\uB3C4\uC758 \uC790\uC5F0 \uAC10\uC18C"
    guide: "\uD63C\uC7A1\uB3C4\uB294 \uC0C8\uB85C\uC6B4 \uC99D\uAC00 \uC6D0\uC778\uC774
      \uC5C6\uC73C\uBA74 \uC11C\uC11C\uD788 \uAC10\uC18C\uD569\uB2C8\uB2E4. \uD63C\uC7A1\uB3C4
      \uAC10\uC18C\uB97C \uD655\uC778\uD558\uC2ED\uC2DC\uC624."
    objective: "\uD63C\uC7A1\uB3C4\uAC00 0\uC774 \uB420 \uB54C\uAE4C\uC9C0 \uAE30\uB2E4\uB9AC\uAC70\uB098
      Tab\uC744 \uB204\uB974\uC138\uC694."
    inputHint: "[Tab] \uB2E4\uC74C \uB2E8\uACC4"
    completion: 
  - stepId: 6
    title: "5. \uD559\uC0DD \uC791\uC5C5 \uC720\uB3C4"
    subtitle: "\uBD80\uC2A4\uD130\uB85C \uD559\uC0DD\uC744 \uC791\uC5C5 \uC0C1\uD0DC\uB85C
      \uC804\uD658"
    guide: "\uB300\uD559\uC6D0\uC0DD\uC740 \uC2A4\uC2A4\uB85C \uC791\uC5C5\uC744
      \uC120\uD0DD\uD558\uAC70\uB098, \uBD80\uC2A4\uD130 \uB4DC\uB9C1\uD06C\uB97C
      \uB9DE\uACE0 \uC791\uC5C5 \uC0C1\uD0DC\uAC00 \uB420 \uC218 \uC788\uC2B5\uB2C8\uB2E4.
      \uD559\uC0DD\uC774 \uC791\uC5C5\uC744 \uC2DC\uC791\uD558\uBA74 \uC0C1\uB2E8\uC758
      \uD504\uB85C\uC81D\uD2B8\uAC00 \uC9C4\uD589\uB429\uB2C8\uB2E4. \uD504\uB85C\uC81D\uD2B8\uB97C
      \uC644\uC131\uD560\uB54C\uB9C8\uB2E4 \uC790\uAE08\uC744 \uD68D\uB4DD\uD569\uB2C8\uB2E4.
      \uC790\uD310\uAE30\uC5D0\uC11C \uBD80\uC2A4\uD130\uB97C \uCDA9\uC804\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    objective: "\uD559\uC0DD\uC758 \uC791\uC5C5 \uC0C1\uD0DC\uB85C \uC720\uC9C0\uD558\uC138\uC694."
    inputHint: "[LMB] \uD22C\uCC99"
    completion: 
  - stepId: 7
    title: "6. \uAD50\uC218 \uC791\uC5C5"
    subtitle: "\uAD50\uC218\uAC00 \uC9C1\uC811 \uD504\uB85C\uC81D\uD2B8 \uC644\uC131"
    guide: "\uAD50\uC218\uB3C4 \uC9C1\uC811 \uD504\uB85C\uC81D\uD2B8\uB97C \uC9C4\uD589\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uC791\uC5C5\uC11D\uC744 \uBC14\uB77C\uBCF4\uACE0
      F\uB97C \uB20C\uB7EC \uC791\uC5C5\uC744 \uC2DC\uC791\uD558\uC138\uC694. \uAD50\uC218\uB2D8\uC774
      \uC791\uC5C5\uD558\uBA74 \uD504\uB85C\uC81D\uD2B8\uB294 \uB354 \uBE60\uB974\uAC8C
      \uC9C4\uD589\uB429\uB2C8\uB2E4. \uAD50\uC218 \uC791\uC5C5\uB9CC\uC73C\uB85C
      \uD504\uB85C\uC81D\uD2B8\uB97C \uD55C \uBC88 \uC644\uC131\uD558\uC138\uC694."
    objective: "\uAD50\uC218 \uC791\uC5C5\uC73C\uB85C \uD504\uB85C\uC81D\uD2B8\uB97C
      \uD55C \uBC88 \uC644\uC131\uD558\uC138\uC694."
    inputHint: "[F] \uC791\uC5C5 \uC2DC\uC791\xB7\uC911\uB2E8"
    completion: 
  - stepId: 10
    title: "\uBBF8\uB2C8\uC6E8\uC774\uBE0C \uC900\uBE44"
    subtitle: "\uC81C\uD55C \uC2DC\uAC04 \uB3D9\uC548 \uC2A4\uD14C\uC774\uC9C0 \uD1B5\uC81C"
    guide: "\uB0A8\uC740 \uC2DC\uAC04, \uD0C8\uCD9C \uC778\uC6D0, \uD63C\uC7A1\uB3C4,
      \uC791\uC5C5 \uC778\uC6D0, \uD504\uB85C\uC81D\uD2B8\uC640 \uD0C8\uCD9C\uAD6C
      \uC0C1\uD0DC\uB97C \uD655\uC778\uD558\uC138\uC694. \uD0C8\uCD9C \uC778\uC6D0\uC774
      \uC2E4\uD328 \uAE30\uC900\uC5D0 \uB3C4\uB2EC\uD558\uBA74 \uC989\uC2DC \uC2E4\uD328\uD569\uB2C8\uB2E4."
    objective: "\uBBF8\uB2C8\uC6E8\uC774\uBE0C \uC900\uBE44\uB97C \uB9C8\uCCE4\uC73C\uBA74
      Tab\uC744 \uB204\uB974\uC2ED\uC2DC\uC624."
    inputHint: 
    completion: 
  - stepId: 8
    title: "7. \uBBF8\uB2C8\uC6E8\uC774\uBE0C"
    subtitle: "\uC81C\uD55C \uC2DC\uAC04 \uB3D9\uC548 \uC2A4\uD14C\uC774\uC9C0 \uD1B5\uC81C"
    guide: 
    objective: "\uC2DC\uAC04 \uC885\uB8CC\uAE4C\uC9C0 \uD0C8\uCD9C \uC778\uC6D0\uC744
      \uC2E4\uD328 \uAE30\uC900 \uBBF8\uB9CC\uC73C\uB85C \uC720\uC9C0\uD558\uC138\uC694."
    inputHint: 
    completion: 
  _riskBehaviorContents:
  - behaviorId: 0
    title: "\uD0C8\uCD9C \uC2DC\uB3C4"
    description: "\uD0C8\uCD9C\uAD6C\uAC00 \uC548\uB9C9\uD600\uC788\uB2E4\uBA74 \uC989\uC2DC
      \uD0C8\uCD9C\uD558\uC9C0\uB9CC, \uBC14\uB9AC\uCF00\uC774\uD2B8\uAC00 \uC124\uCE58\uB410\uB2E4\uBA74
      \uD559\uC0DD\uC774 \uACF5\uACA9\uC744 \uD1B5\uD574 \uBB34\uB825\uD654\uD6C4\uC5D0
      \uD0C8\uCD9C\uD569\uB2C8\uB2E4."
  - behaviorId: 1
    title: "\uC2DC\uC2A4\uD15C \uD574\uD0B9"
    description: "\uC77C\uC815 \uC2DC\uAC04\uB3D9\uC548 \uD559\uC0DD\uC758 \uD574\uD0B9
      \uD589\uB3D9\uC744 \uD5C8\uC6A9\uD560 \uACBD\uC6B0, \uC5F0\uAD6C\uC2E4 \uC804\uCCB4\uC758
      \uBD88\uC774 \uAEBC\uC9D1\uB2C8\uB2E4. \uC5F0\uAD6C\uC2E4\uC758 \uC804\uC6D0\uAE30\uB97C
      \uCC3E\uC544\uC11C \uC804\uC6D0\uC744 \uC62C\uB9AC\uBA74 \uC804\uB4F1\uC774
      \uBCF5\uAD6C\uB429\uB2C8\uB2E4."
  - behaviorId: 2
    title: "\uC800\uC9C8 \uB178\uB798"
    description: "\uD559\uC0DD\uC758 \uD63C\uB780 \uC720\uBC1C \uD589\uB3D9\uC911
      \uD558\uB098\uC785\uB2C8\uB2E4. \uADF8\uB0E5 \uBC29\uCE58\uD558\uBA74 \uC9C0\uC18D\uC801\uC73C\uB85C
      \uD63C\uB780 \uC218\uCE58\uB97C \uC99D\uAC00\uC2DC\uD0A4\uB2C8 \uCD5C\uB300\uD55C
      \uB450\uB4E4\uACA8\uD328\uC57C \uD569\uB2C8\uB2E4."
  - behaviorId: 3
    title: "\uC2E4\uB0B4 \uD761\uC5F0"
    description: "\uC774\uC640 \uAC19\uC740 \uD654\uC7AC \uD589\uB3D9\uC744 \uC77C\uC815
