  m_Script: {fileID: 11500000, guid: b47a396a17197594e92e0fa496b23d8c, type: 3}
  m_Name: TutorialCourseDefinition
  m_EditorClassIdentifier: Assembly-CSharp::TutorialCourseDefinition
  _steps:
  - stepId: 0
    title: "0\uB2E8\uACC4. \uC5F0\uC218 \uC2DC\uC791"
    subtitle: "\uC2E0\uC784 \uAD50\uC218 \uC5F0\uC218\uC5D0 \uC624\uC2E0 \uAC83\uC744
      \uD658\uC601\uD569\uB2C8\uB2E4."
    guide: "\uAD50\uC218\uB2D8\uC758 \uC8FC\uC694 \uC784\uBB34\uB294 \uC81C\uD55C
      \uC2DC\uAC04 \uB3D9\uC548 \uB300\uD559\uC6D0\uC0DD\uC758 \uD0C8\uCD9C\uC744
      \uAC10\uC2DC\uD558\uACE0 \uD504\uB85C\uC81D\uD2B8\uB97C \uC9C4\uD589\uD574
      \uB354 \uC6D0\uD65C\uD55C \uD1B5\uC81C\uB97C \uC704\uD55C \uC790\uAE08\uC744
      \uB9C8\uB828\uD558\uB294 \uAC83\uC785\uB2C8\uB2E4. \uC774\uBC88 \uC5F0\uC218\uC5D0\uC11C\uB294
      \uBCF8\uACA9\uC801\uC778 \uAD50\uC218 \uC5C5\uBB34\uC5D0 \uD544\uC694\uD55C
      \uD0C8\uCD9C\uAD6C \uBD09\uC1C4, \uB300\uD559\uC6D0\uC0DD \uAD00\uB9AC, \uC791\uC5C5
      \uC720\uB3C4 \uB4F1\uC744 \uC775\uD799\uB2C8\uB2E4."
    objective: "[Tab]\uC744 \uB20C\uB7EC \uC5F0\uC218\uB97C \uC2DC\uC791\uD558\uC138\uC694."
    inputHint: "[Tab] \uC2DC\uC791"
    completion: 
  - stepId: 1
    title: "1. \uC774\uB3D9\uACFC \uAE30\uBCF8 \uC870\uC791"
    subtitle: "\uD45C\uC2DC\uB41C \uC704\uCE58\uB85C \uC774\uB3D9"
    guide: "\uC5F0\uAD6C\uC2E4\uC744 \uD1B5\uC81C\uD558\uB824\uBA74 \uC274 \uC0C8
      \uC5C6\uC774 \uC6C0\uC9C1\uC5EC\uC57C \uD569\uB2C8\uB2E4. [\uB9C8\uC6B0\uC2A4]\uB85C
      \uC2DC\uC810\uC744 \uB3CC\uB9AC\uACE0 [WASD]\uB85C \uC774\uB3D9\uD558\uC138\uC694.
      [Shift]\uB85C \uB2EC\uB9AC\uACE0 [Space]\uB85C \uC810\uD504\uD560 \uC218 \uC788\uC73C\uBA70,
      \uB450 \uD589\uB3D9 \uBAA8\uB450 \uC88C\uCE21 \uD558\uB2E8\uC758 \uC2A4\uD0DC\uBBF8\uB098\uB97C
      \uC18C\uBAA8\uD569\uB2C8\uB2E4."
    objective: "\uD45C\uC2DC\uB41C \uC9C0\uC810\uC73C\uB85C \uC774\uB3D9\uD558\uC138\uC694."
    inputHint: "[WASD] \uC774\uB3D9\\n[Shift] \uB2EC\uB9AC\uAE30\\n[Space] \uC810\uD504"
    completion: 
  - stepId: 2
    title: "2. \uD0C8\uCD9C\uAD6C \uBD09\uC1C4"
    subtitle: "\uBAA8\uB4E0 \uBB38\uACFC \uCC3D\uBB38\uC5D0 \uBC14\uB9AC\uCF00\uC774\uB4DC
      \uC124\uCE58"
    guide: "\uBB38\uACFC \uCC3D\uBB38\uC740 \uB300\uD559\uC6D0\uC0DD\uC758 \uD0C8\uCD9C\uAD6C\uC785\uB2C8\uB2E4.
      \uD45C\uC2DC\uB41C <color=red><u>\uD0C8\uCD9C\uAD6C</u></color>\uC5D0 \uC811\uADFC\uD574
      [F]\uB97C \uB204\uB974\uACE0 \uBC14\uB9AC\uCF00\uC774\uB4DC\uB97C \uC124\uCE58\uD558\uC138\uC694.
      \uBC14\uB9AC\uCF00\uC774\uB4DC\uB294 \uD559\uC0DD\uC758 \uD0C8\uCD9C\uC744
      \uB2A6\uCDA5\uB2C8\uB2E4."
    objective: "\uBAA8\uB4E0 \uD0C8\uCD9C\uAD6C\uC5D0 \uBC14\uB9AC\uCF00\uC774\uB4DC\uB97C
      \uC124\uCE58\uD558\uC138\uC694."
    inputHint: "[F] \uBC14\uB9AC\uCF00\uC774\uB4DC \uC124\uCE58"
    completion: 
  - stepId: 3
    title: "3-1. \uC704\uD5D8 \uD589\uB3D9 \uAD6C\uBD84\uACFC \uB300\uC751"
    subtitle: "\uC815\uC0C1 \uD589\uB3D9\uACFC \uC704\uD5D8 \uD589\uB3D9 \uC2DD\uBCC4"
    guide: "\uC77C\uBD80 \uD559\uC0DD \uD589\uB3D9\uC740 \uD0C8\uCD9C\uACFC \uC9C1\uAC04\uC811\uC801\uC73C\uB85C
      \uC5F0\uAD00\uB41C \uC704\uD5D8\uD55C \uD589\uB3D9\uC744 \uD569\uB2C8\uB2E4.
      \uC815\uC0C1 \uD589\uB3D9\uACFC \uC704\uD5D8 \uD589\uB3D9\uC744 \uAD6C\uBD84\uD574
      \uC704\uD5D8 \uD559\uC0DD\uB9CC \uC81C\uC555\uD574\uC57C \uD569\uB2C8\uB2E4.
      [1~4] \uB610\uB294 [\uB9C8\uC6B0\uC2A4 \uD720]\uB85C \uBB34\uAE30\uB97C \uBC14\uAFB8\uACE0
      [LMB]\uB85C \uC0AC\uC6A9\uD558\uC138\uC694. \uC6D0\uAC70\uB9AC \uBB34\uAE30\uB294
      <color=green><u>\uCC45\uC7A5</u></color>\uC5D0\uC11C \uBCF4\uCDA9\uD560 \uC218
      \uC788\uC2B5\uB2C8\uB2E4. \uC774\uBC88 \uB2E8\uACC4\uC5D0\uC11C\uB294 \uC704\uD5D8
      \uD589\uB3D9\uC758 \uBD80\uAC00 \uD6A8\uACFC\uAC00 \uBC1C\uC0DD\uD558\uC9C0
      \uC54A\uC2B5\uB2C8\uB2E4."
    objective: "\uC704\uD5D8 \uD589\uB3D9 \uC911\uC778 \uD559\uC0DD\uC744 \uC4F0\uB7EC\uB728\uB9AC\uC138\uC694."
    inputHint: "[LMB] \uACF5\uACA9\\n[1~4,\uB9C8\uC6B0\uC2A4\uD720] \uC7A5\uBE44
      \uC120\uD0DD"
    completion: 
  - stepId: 11
    title: "3-2. \uC815\uC804 \uB300\uC751"
    subtitle: 
    guide: "\uB9CC\uC57D \uD574\uD0B9\uD558\uB294 \uD559\uC0DD\uC744 \uBC29\uCE58\uD588\uB2E4\uBA74
      \uBAA8\uB4E0 \uC804\uB4F1\uC774 \uAEBC\uC838\uC11C \uC5F0\uAD6C\uC2E4 \uD1B5\uC81C\uC5D0
      \uC9C0\uC7A5\uC774 \uC0DD\uAE41\uB2C8\uB2E4. \uD45C\uC2DC\uB41C \uC804\uAE30\uBC15\uC2A4\uC5D0
      \uC811\uADFC\uD574 [F]\uB97C \uB20C\uB7EC \uC804\uC6D0\uC744 \uBCF5\uAD6C\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    objective: "\uC804\uAE30\uBC15\uC2A4\uC5D0\uC11C \uC804\uC6D0\uC744 \uBCF5\uAD6C\uD558\uC138\uC694."
    inputHint: 
    completion: 
  - stepId: 12
    title: "3-3. \uC804\uC790\uB808\uC778\uC9C0 \uD654\uC7AC \uC608\uBC29"
    subtitle: 
    guide: "\uD559\uC0DD\uB4E4\uC774 \uC804\uC790\uB808\uC778\uC9C0\uB85C \uAC00\uC5F4\uC2DC\uD0A4\uB294
      \uC77C\uBD80 \uC74C\uC2DD\uC740 \uD654\uC7AC\uB97C \uC77C\uC73C\uD0B5\uB2C8\uB2E4.
      \uC804\uC790\uB808\uC778\uC9C0\uB97C \uBC14\uB77C\uBCFC \uB54C \uC624\uB978\uCABD
      3\uAC1C\uB294 \uC704\uD5D8 \uC74C\uC2DD, \uC67C\uCABD 3\uAC1C\uB294 \uC815\uC0C1
      \uC74C\uC2DD\uC785\uB2C8\uB2E4. \uC804\uC790\uB808\uC778\uC9C0\uC5D0 \uC704\uD5D8
      \uC74C\uC2DD\uC744 \uB123\uC73C\uB7EC \uAC00\uB294 \uD559\uC0DD\uC744 \uBBF8\uB9AC
      \uC800\uC9C0\uD560 \uC218 \uC788\uC9C0\uB9CC \uC774\uBBF8 \uC74C\uC2DD\uC774
      \uB4E4\uC5B4\uAC14\uC5B4\uB3C4 \uD3ED\uBC1C\uD558\uAE30 \uC804\uC5D0 \uAEBC\uB0BC
      \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uC774\uBC88 \uC5F0\uC218\uC5D0\uC11C\uB294
      \uD3ED\uBC1C\uC774 \uBC1C\uC0DD\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    objective: "\uC704\uD5D8 \uC74C\uC2DD\uC744 \uC804\uC790\uB808\uC778\uC9C0\uC5D0\uC11C
      \uBE7C\uC2ED\uC2DC\uC624."
    inputHint: 
    completion: 
  - stepId: 4
    title: "4-1. \uD63C\uB780 \uAD00\uB9AC"
    subtitle: "\uD63C\uC7A1\uB3C4 \uC99D\uAC00 \uD655\uC778"
    guide: "\uD63C\uB780 \uC218\uCE58\uAC00 \uB192\uC744\uC218\uB85D \uD559\uC0DD\uB4E4\uC758
      \uD589\uB3D9\uC774 \uBE68\uB77C\uC838 \uD1B5\uC81C\uAC00 \uC5B4\uB824\uC6CC\uC9D1\uB2C8\uB2E4.
      \uBB34\uACE0\uD55C \uD559\uC0DD \uC81C\uC555, \uC815\uC0C1 \uC74C\uC2DD \uC81C\uAC70,
      \uD559\uC0DD\uC758 \uD63C\uB780 \uC720\uBC1C \uD589\uB3D9 \uB4F1\uC73C\uB85C
      \uD63C\uB780\uC774 \uC99D\uAC00\uD569\uB2C8\uB2E4."
    objective: "\uC9C0\uC815\uB41C \uBB34\uACE0\uD55C \uD559\uC0DD\uC744 \uC4F0\uB7EC\uB728\uB9AC\uC138\uC694."
    inputHint: "\uC9C0\uC815 \uD559\uC0DD\uC744 \uACF5\uACA9\uD558\uC138\uC694."
    completion: 
  - stepId: 5
    title: "4-2. \uD63C\uB780 \uAC10\uC18C"
    subtitle: "\uD63C\uC7A1\uB3C4\uC758 \uC790\uC5F0 \uAC10\uC18C"
    guide: "\uD63C\uB780\uC740 \uC0C8\uB85C\uC6B4 \uC99D\uAC00 \uC6D0\uC778\uC774
      \uC5C6\uC73C\uBA74 \uC11C\uC11C\uD788 \uAC10\uC18C\uD569\uB2C8\uB2E4. \uC88C\uCE21
      \uC0C1\uB2E8\uC758 \uD63C\uB780 \uC218\uCE58\uB97C \uD655\uC778\uD569\uB2C8\uB2E4."
    objective: "\uD63C\uB780 \uAC10\uC18C\uB97C \uD655\uC778\uD558\uACE0 Tab\uC744
      \uB204\uB974\uC138\uC694."
    inputHint: "[Tab] \uB2E4\uC74C \uB2E8\uACC4"
    completion: 
  - stepId: 6
    title: "5. \uD559\uC0DD \uC791\uC5C5 \uC720\uB3C4"
    subtitle: "\uBD80\uC2A4\uD130\uB85C \uD559\uC0DD\uC744 \uC791\uC5C5 \uC0C1\uD0DC\uB85C
      \uC804\uD658"
    guide: "\uD559\uC0DD\uC740 \uC2A4\uC2A4\uB85C \uC791\uC5C5\uD558\uB7EC \uAC00\uAC70\uB098
      \uBD80\uC2A4\uD130 \uB4DC\uB9C1\uD06C\uB97C \uB9DE\uACE0 \uD655\uB960\uC801\uC73C\uB85C
      \uC791\uC5C5 \uC0C1\uD0DC\uAC00 \uB420 \uC218 \uC788\uC2B5\uB2C8\uB2E4. (\uB2E8,
      \uC774\uBC88 \uC5F0\uC218 \uB2E8\uACC4\uC5D0\uC11C\uB294 \uBD80\uC2A4\uD130\uC758
      \uC791\uC5C5 \uBC1C\uB3D9 \uD655\uB960\uC774 100%\uC785\uB2C8\uB2E4.) \uC791\uC5C5
      \uC911\uC778 \uD559\uC0DD\uC740 \uD504\uB85C\uC81D\uD2B8 \uC9C4\uD589\uC5D0
      \uAE30\uC5EC\uD558\uBA70, \uD504\uB85C\uC81D\uD2B8\uB97C \uC644\uC131\uD560
      \uB54C\uB9C8\uB2E4 \uC790\uAE08\uC744 \uD68D\uB4DD\uD569\uB2C8\uB2E4. [LMB]\uB85C
      \uBD80\uC2A4\uD130\uB97C \uB358\uC9C0\uACE0 <color=#00FFFF><u>\uC790\uD310\uAE30</u></color>\uC5D0\uC11C
      \uCDA9\uC804\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    objective: "\uD559\uC0DD\uC5D0\uAC8C \uC791\uC5C5\uC744 \uC2DC\uD0A4\uC138\uC694."
    inputHint: "[LMB] \uD22C\uCC99"
    completion: 
  - stepId: 7
    title: "6. \uAD50\uC218 \uC791\uC5C5"
    subtitle: "\uAD50\uC218\uAC00 \uC9C1\uC811 \uD504\uB85C\uC81D\uD2B8 \uC644\uC131"
    guide: "\uAD50\uC218\uB3C4 \uD504\uB85C\uC81D\uD2B8\uC5D0 \uC9C1\uC811 \uCC38\uC5EC\uD560
      \uC218 \uC788\uC73C\uBA70 \uD559\uC0DD\uBCF4\uB2E4 \uBE60\uB974\uAC8C \uC9C4\uD589\uD569\uB2C8\uB2E4.
      <color=purple><u>\uC791\uC5C5\uC11D</u></color>\uC5D0 \uC811\uADFC\uD574 [F]\uB85C
      \uC791\uC5C5\uC744 \uC2DC\uC791\uD558\uACE0 \uD504\uB85C\uC81D\uD2B8\uB97C
      \uC644\uC131\uD569\uB2C8\uB2E4."
    objective: "\uAD50\uC218 \uC791\uC5C5\uC73C\uB85C \uD504\uB85C\uC81D\uD2B8\uB97C
      \uC644\uC131\uD558\uC138\uC694."
    inputHint: "[F] \uC791\uC5C5 \uC2DC\uC791\xB7\uC911\uB2E8"
    completion: 
  - stepId: 10
    title: "\uBBF8\uB2C8\uC6E8\uC774\uBE0C \uC900\uBE44"
    subtitle: "\uC81C\uD55C \uC2DC\uAC04 \uB3D9\uC548 \uC2A4\uD14C\uC774\uC9C0 \uD1B5\uC81C"
    guide: "\uC0C1\uB2E8 \uD328\uB110\uC758 \uB0A8\uC740 \uC2DC\uAC04, \uD63C\uB780,
      \uD0C8\uCD9C \uC778\uC6D0\uACFC \uC5F0\uAD6C\uC2E4\uC758 \uD0C8\uCD9C\uAD6C
      \uC0C1\uD0DC\uB97C \uD655\uC778\uD558\uC138\uC694. \uD0C8\uCD9C \uC778\uC6D0\uC774
      \uC2E4\uD328 \uAE30\uC900\uC5D0 \uB3C4\uB2EC\uD558\uC9C0 \uC54A\uB3C4\uB85D
      \uD1B5\uC81C\uD569\uB2C8\uB2E4."
    objective: "[Tab]\uC744 \uB20C\uB7EC \uBBF8\uB2C8\uC6E8\uC774\uBE0C\uB97C \uC2DC\uC791\uD558\uC138\uC694."
    inputHint: 
    completion: 
  - stepId: 8
    title: "7. \uBBF8\uB2C8\uC6E8\uC774\uBE0C"
    subtitle: "\uC81C\uD55C \uC2DC\uAC04 \uB3D9\uC548 \uC2A4\uD14C\uC774\uC9C0 \uD1B5\uC81C"
    guide: 
    objective: "\uD0C8\uCD9C \uC778\uC6D0\uC744 \uC2E4\uD328 \uAE30\uC900 \uBBF8\uB9CC\uC73C\uB85C
      \uC720\uC9C0\uD558\uC138\uC694."
    inputHint: 
    completion: 
  _riskBehaviorContents:
  - behaviorId: 0
    title: "\uD0C8\uCD9C \uC2DC\uB3C4"
    description: "\uD0C8\uCD9C\uAD6C\uC5D0 \uBC14\uB9AC\uCF00\uC774\uB4DC\uAC00 \uC5C6\uC73C\uBA74
      \uBC14\uB85C \uBE60\uC838\uB098\uAC08 \uAC70\uC608\uC694. \uBC14\uB9AC\uCF00\uC774\uB4DC\uAC00
      \uC788\uC73C\uBA74 \uBD80\uC21C \uB2E4\uC74C\uC5D0 \uD0C8\uCD9C\uD560 \uAC81\uB2C8\uB2E4."
  - behaviorId: 1
    title: "\uC2DC\uC2A4\uD15C \uD574\uD0B9"
    description: "\uC624\uB798 \uB0B4\uBC84\uB824 \uB450\uBA74 \uD574\uD0B9\uC73C\uB85C
      \uC5F0\uAD6C\uC2E4\uC758 \uBD88\uC744 \uBAA8\uB450 \uB04C \uAC70\uC608\uC694.
      \uAEBC\uC9C4 \uC804\uB4F1\uC740 \uC804\uAE30\uBC15\uC2A4\uC5D0\uC11C \uBCF5\uAD6C\uD560
      \uC218 \uC788\uC5B4\uC694."
  - behaviorId: 2
    title: "\uC800\uC9C8 \uB178\uB798"
    description: "\uC774\uC0C1\uD55C \uB178\uB798\uB85C \uC5F0\uAD6C\uC2E4\uC744
      \uD63C\uB780\uC2A4\uB7FD\uAC8C \uD574\uC694. \uB2E4\uB978 \uD63C\uB780 \uC720\uBC1C
      \uD589\uB3D9\uACFC \uB9C8\uCC2C\uAC00\uC9C0\uB85C \uD574\uB2F9 \uD559\uC0DD\uC744
      \uCD5C\uB300\uD55C \uBE68\uB9AC \uC4F0\uB7EC\uB728\uB824\uC57C \uD569\uB2C8\uB2E4."
  - behaviorId: 3
    title: "\uC2E4\uB0B4 \uD761\uC5F0"
    description: "\uACC4\uC18D \uB2F4\uBC30\uB97C \uD53C\uC6B0\uBA74 \uD654\uC7AC\uACBD\uBCF4\uAE30\uAC00
